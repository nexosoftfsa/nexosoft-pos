# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
build/
out/
*.tsbuildinfo

# Panel web compilado que el cloud-api sirve estatico. Lo genera el build de
# admin-web (ver instalacion-primer-cliente.md y armar-paquete-servidor.ps1):
# es un artefacto local, no codigo fuente.
/apps/cloud-api/panel/

# Paquete standalone del servidor (Fase 13) y runtimes portables embebidos
/dist-servidor/
/NexoSoftBuild/
/instalador-servidor/.cache/
/instalador-servidor/runtime/

# Datos exportados para entregar a otro comercio (Fase 14) -- no es codigo
/_entregar-a-socio/
/instalador-servidor/dist/
/instalador-servidor/Output/

# Maqueta: archivo portable generado por prototipo/build-standalone.js
prototipo/nexosoft-maqueta.html

# Turborepo
.turbo/

# Rust / Tauri
target/
apps/pos-desktop/src-tauri/target/
apps/pos-desktop/src-tauri/gen/

# Entorno y secretos (NUNCA versionar)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
/secrets/
/certs/

# Bases de datos locales
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Respaldos generados (ADR-0020)
respaldos/
*.json.gz

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Cobertura / tests
coverage/
.vitest/

# Editores / SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code: config local (rutas/permisos de esta PC), no se comparte
.claude/settings.local.json

# Herramientas descargadas manualmente (ej. cloudflared.exe), no son codigo
/.herramientas/

# Clave de firma del updater del POS (NUNCA versionar: quien la tenga puede
# firmar "actualizaciones" falsas que todos los clientes instalarian solos)
*.key.password.txt
