  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node ./marcar-dist-commonjs.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
