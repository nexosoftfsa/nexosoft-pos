{
  "name": "@nexosoft/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tipos y lógica de dominio compartida (dinero, comprobantes, IVA).",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    }
