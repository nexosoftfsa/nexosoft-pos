# ==========================================================================
# NexoSoft — Variables de entorno (EJEMPLO). Copiar a .env y completar.
# NO versionar .env ni los archivos de certificados reales.
# ==========================================================================

# === Cloud API (NestJS) ===
NODE_ENV=development
API_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://nexosoft:nexosoft@localhost:5432/nexosoft

# === Autenticación / RBAC ===
JWT_SECRET=cambiar-en-produccion-por-un-secreto-fuerte
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=cambiar-en-produccion-por-otro-secreto-fuerte
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_DAYS=30

# === ARCA (ex AFIP) ===
# Entorno: homologacion | produccion
ARCA_ENV=homologacion
ARCA_CUIT=20111111112
# Rutas a certificados X.509 (los archivos viven fuera del repo: ver /secrets)
ARCA_CERT_PATH=./secrets/arca/cert.pem
ARCA_KEY_PATH=./secrets/arca/private.key
ARCA_KEY_PASSPHRASE=

# === IA / LLM (OCR de facturas + asistente de métricas) ===
# Proveedor elegido: Google Gemini (ver ADR-0011). Detrás de interfaz ProveedorLLM.
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# === Pagos electrónicos (ver ADR-0010) ===
# Pasarela: MercadoPago (Point + QR). Detrás de interfaz PasarelaDePago.
PAGOS_PROVIDER=mercadopago
MP_ENV=sandbox
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# === Sincronización offline-first ===
# custom | powersync | electricsql | rxdb (decisión final: ver ADR-0005)
SYNC_BACKEND=custom

# === Respaldo en nube propia (ver ADR-0020) ===
# Carpeta donde se escriben los snapshots. Si apunta a la carpeta de
# Google Drive / OneDrive Desktop, la nube los sube sola (sin integrar API).
# Tambien sirve para disco externo o NAS.
RESPALDO_RUTA=./respaldos
# Cuantos respaldos conservar (los mas viejos se eliminan).
RESPALDO_RETENER=7
# Expresion cron para respaldo automatico (vacio = solo manual / al cerrar caja).
# Ejemplo: "0 23 * * *" = todos los dias a las 23:00.
RESPALDO_CRON=
# Generar un snapshot completo de la base despues de CADA venta. Default false:
# en alto volumen es costoso. El libro de ventas Excel SI se actualiza siempre.
RESPALDO_EN_CADA_VENTA=false

# === Libro de ventas (Excel, ver ADR-0021) ===
# Archivo Excel que se actualiza en cada venta para control del dueno.
# Por defecto vive en RESPALDO_RUTA/ventas.xlsx (viaja a la nube propia).
# LIBRO_VENTAS_ARCHIVO=./respaldos/ventas.xlsx
