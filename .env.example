# ==========================================================================
# NexoSoft — Variables de entorno (EJEMPLO). Copiar a .env y completar.
# NO versionar .env ni los archivos de certificados reales.
# ==========================================================================

# === Cloud API (NestJS) ===
NODE_ENV=development
API_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://nexosoft:nexosoft@localhost:5432/nexosoft

# === Autenticación / RBAC ===
JWT_SECRET=cambiar-en-produccion-por-un-secreto-fuerte
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# === ARCA (ex AFIP) ===
# Entorno: homologacion | produccion
ARCA_ENV=homologacion
ARCA_CUIT=20111111112
# Rutas a certificados X.509 (los archivos viven fuera del repo: ver /secrets)
ARCA_CERT_PATH=./secrets/arca/cert.pem
ARCA_KEY_PATH=./secrets/arca/private.key
ARCA_KEY_PASSPHRASE=

# === IA / LLM (OCR de facturas + asistente de métricas) ===
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# === Sincronización offline-first ===
# custom | powersync | electricsql | rxdb (decisión final: ver ADR-0005)
SYNC_BACKEND=custom
