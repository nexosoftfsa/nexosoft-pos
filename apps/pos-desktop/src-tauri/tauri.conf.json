{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "NexoSoft POS",
    "version":  "0.1.40",
    "identifier":  "ar.nexosoft.pos",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "corepack pnpm dev",
                  "beforeBuildCommand":  "corepack pnpm build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "NexoSoft POS",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1024,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "maximized":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "languages":  [
                                                                  "Spanish"
                                                              ],
                                                "installMode":  "currentUser"
                                            }
                               },
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QkYwODg5RTVDRTgzRDUKUldUVmc4N2xpUWkvTmNBQ0VTZk55Q0c5UStHR0JzbWR6Y2JWRFBOUEEvZmF2U1c3VnViSEZ2SEQK",
                                    "endpoints":  [
                                                      "https://github.com/nexosoftfsa/nexosoft-pos-releases/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}