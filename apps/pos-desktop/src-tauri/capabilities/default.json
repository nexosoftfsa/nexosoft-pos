{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default",
    "process:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "actualizar-servidor",
          "cmd": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command",
            "$p = Start-Process -FilePath powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','C:\\NexoSoft\\scripts\\actualizacion\\actualizar-servidor.ps1') -Verb RunAs -Wait -PassThru; exit $p.ExitCode"
          ]
        }
      ]
    }
  ]
}
