// NexoSoft — schema Prisma
// Multi-sucursal desde el MVP: todas las tablas de negocio llevan sucursalId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configuración del servidor editable desde la UI (una sola fila). Hoy solo
/// guarda la clave del Asistente IA (Gemini); si `.env` tiene GEMINI_API_KEY,
/// esta fila (si existe) tiene prioridad — ver ADR-0040.
model ConfiguracionSistema {
  id            Int      @id @default(1)
  geminiApiKey  String?
  geminiModel   String?
  /// Logo del comercio como data URL (ver ADR del panel/branding). Lo sirve
  /// admin-web; el POS tiene su propia copia local (SQLite, independiente).
  logoBase64    String?
  /// Fase 17.B (ADR-0056). Ultima licencia de suscripcion recibida, tal como
  /// vino firmada del Worker. Se guarda para que un reinicio del servidor no
  /// la pierda: si no, un comercio bloqueado se desbloquearia reiniciando.
  /// No es un secreto -- solo se puede leer, no falsificar.
  licenciaToken String?
  licenciaComercioId String?

  /// Datos fiscales del comercio (Fase 18). Hasta ahora vivían sólo en la
  /// copia local del POS, pero para pedirle el CAE a ARCA los necesita el
  /// SERVIDOR: es el que habla con ARCA, y cada terminal podría tener una
  /// copia distinta. El POS los empuja acá al guardar Configuración.
  cuit          String?
  razonSocial   String?
  puntoDeVenta  Int?
  /// "ResponsableInscripto" | "Monotributo" — decide si se emite A/B o C.
  condicionIvaEmisor String?
  /// "homologacion" | "produccion". Se arranca en homologación a propósito:
  /// facturar de verdad tiene que ser una decisión explícita.
  arcaEntorno   String?  @default("homologacion")

  actualizadoEn DateTime @updatedAt

  @@map("configuracion_sistema")
}

// ─── Sucursal ────────────────────────────────────────────────────────────────

model Sucursal {
  id        String   @id @default(cuid())
  nombre    String
  direccion String?
  activa    Boolean  @default(true)
  creadaEn  DateTime @default(now())

  usuarios  Usuario[]
  productos Producto[]
  ventas    Venta[]
  movimientosStock MovimientoStock[]
  terminales Terminal[]
  turnosCaja TurnoCaja[]
  movimientosCaja MovimientoCaja[]
  clientes Cliente[]
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
  proveedores Proveedor[]
  tarjetasConfig TarjetaConfig[]
  presupuestos Presupuesto[]
  remitos Remito[]
  lotes Lote[]
  registrosAuditoria RegistroAuditoria[]

  @@map("sucursales")
}

// ─── Terminales (cajas) ──────────────────────────────────────────────────────

model Terminal {
  id         String   @id @default(cuid())
  nombre     String
  activa     Boolean  @default(true)
  creadaEn   DateTime @default(now())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  ventas     Venta[]
  turnosCaja TurnoCaja[]

  @@map("terminales")
}

// ─── Usuarios ────────────────────────────────────────────────────────────────

enum RolUsuario {
  ADMIN
  CAJERO
  SUPERVISOR
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  nombreDisplay String
  passwordHash String
  rol          RolUsuario @default(CAJERO)
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())
  /// Foto de perfil como data URL (mismo patrón que ConfiguracionSistema.logoBase64).
  /// Se usa en la credencial física y en el ABM de usuarios; null = sin foto.
  fotoBase64   String?

  sucursalId   String
  sucursal     Sucursal   @relation(fields: [sucursalId], references: [id])

  refreshTokens RefreshToken[]
  ventas        Venta[]
  turnosCaja    TurnoCaja[]
  credencialAcceso  CredencialAcceso?
  registrosAuditoria RegistroAuditoria[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  @@map("refresh_tokens")
}

/// Credencial de acceso por código de barras (Fase 15.A, ver ADR-0051). Codifica
/// un token dedicado — nunca la contraseña real — revocable/regenerable de forma
/// independiente. Solo se persiste el hash (mismo criterio que Usuario.passwordHash).
model CredencialAcceso {
  id          String    @id @default(cuid())
  usuarioId   String    @unique
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// argon2.hash(tokenPlano). El token en claro nunca se persiste.
  tokenHash   String
  /// Se incrementa en cada regeneración; permite invalidar la credencial anterior.
  version     Int       @default(1)
  activa      Boolean   @default(true)
  creadaEn    DateTime  @default(now())
  revocadaEn  DateTime?
  ultimoUsoEn DateTime?

  @@map("credenciales_acceso")
}

/// Auditoría de operaciones sensibles (CLAUDE.md §5). Primera implementación,
/// acotada a login/credenciales en Fase 15; reusable para caja, precios y
/// anulaciones en fases futuras.
model RegistroAuditoria {
  id         String   @id @default(cuid())
  /// LOGIN_CREDENCIAL | LOGIN_CREDENCIAL_FALLIDO | CREDENCIAL_REGENERADA |
  /// CREDENCIAL_REVOCADA | LOGIN_BLOQUEADO (Fase 15.B)
  accion     String
  entidad    String
  entidadId  String?
  exito      Boolean  @default(true)
  /// Texto libre; nunca datos sensibles (token, password).
  detalle    String?
  ip         String?

  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  creadoEn   DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([sucursalId, creadoEn])
  @@map("registro_auditoria")
}

// ─── Catálogo ─────────────────────────────────────────────────────────────────

enum TipoIva {
  EXENTO
  IVA_10_5
  IVA_21
  IVA_27
}

model Categoria {
  id       String     @id @default(cuid())
  nombre   String
  productos Producto[]

  @@map("categorias")
}

enum TipoProducto {
  SIMPLE // producto físico con stock propio
  COMBO  // agrupa otros productos; al venderse descuenta stock de sus componentes
}

model Producto {
  id          String    @id @default(cuid())
  codigo      String    // código de barras o interno
  nombre      String
  descripcion String?
  precioVenta Decimal   @db.Decimal(12, 2)
  precioCosto Decimal   @db.Decimal(12, 2)
  tipoIva     TipoIva   @default(IVA_21)
  tipo        TipoProducto @default(SIMPLE)
  // Los perecederos se gestionan por lotes con vencimiento (Fase 8.2).
  requiereLote Boolean  @default(false)
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  actualizadoEn DateTime @updatedAt

  sucursalId  String
  sucursal    Sucursal  @relation(fields: [sucursalId], references: [id])

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  itemsVenta  ItemVenta[]
  movimientosStock MovimientoStock[]
  lotes       Lote[]

  // Combos: los componentes cuando este producto es un COMBO, y los combos que
  // lo usan como componente (back-relation).
  componentes ComboComponente[] @relation("ComboAComponentes")
  enCombos    ComboComponente[] @relation("ComponenteEnCombos")

  @@unique([codigo, sucursalId])
  @@map("productos")
}

/**
 * Un componente de un combo: qué producto entra y en qué cantidad. Al vender el
 * combo, el stock se descuenta de estos componentes (ADR-0033). Un combo no
 * puede repetir el mismo componente (`@@unique`).
 */
model ComboComponente {
  id           String   @id @default(cuid())
  cantidad     Decimal  @db.Decimal(12, 3)

  comboId      String
  combo        Producto @relation("ComboAComponentes", fields: [comboId], references: [id], onDelete: Cascade)

  componenteId String
  componente   Producto @relation("ComponenteEnCombos", fields: [componenteId], references: [id])

  @@unique([comboId, componenteId])
  @@map("combo_componentes")
}

// ─── Stock ────────────────────────────────────────────────────────────────────

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
}

model MovimientoStock {
  id          String         @id @default(cuid())
  tipo        TipoMovimiento
  cantidad    Decimal        @db.Decimal(12, 3)
  motivo      String?
  creadoEn    DateTime       @default(now())

  productoId  String
  producto    Producto       @relation(fields: [productoId], references: [id])

  sucursalId  String
  sucursal    Sucursal       @relation(fields: [sucursalId], references: [id])

  ventaId     String?
  venta       Venta?         @relation(fields: [ventaId], references: [id])

  // Lote al que se imputa el movimiento (solo productos con requiereLote).
  loteId      String?
  lote        Lote?          @relation(fields: [loteId], references: [id])

  // Remito que originó el movimiento (salida por entrega / su reversa al anular).
  remitoId    String?
  remito      Remito?        @relation(fields: [remitoId], references: [id])

  @@map("movimientos_stock")
}

/**
 * Un lote de un producto perecedero (Fase 8.2). El saldo del lote se deriva de
 * sus `MovimientoStock` (ENTRADA/AJUSTE suman, SALIDA/VENTA restan). Las salidas
 * consumen los lotes por FEFO (vence antes, sale antes).
 */
model Lote {
  id              String   @id @default(cuid())
  numero          String?  // número/código de lote del proveedor (opcional)
  fechaVencimiento DateTime
  creadoEn        DateTime @default(now())

  productoId      String
  producto        Producto @relation(fields: [productoId], references: [id])

  sucursalId      String
  sucursal        Sucursal @relation(fields: [sucursalId], references: [id])

  movimientos     MovimientoStock[]

  @@index([productoId, fechaVencimiento])
  @@map("lotes")
}

// ─── Ventas ──────────────────────────────────────────────────────────────────

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

/// Situación del comprobante ante ARCA. Ver `Venta.estadoFiscal`.
enum EstadoFiscal {
  /// No lleva CAE: ticket interno, presupuesto, comercio sin alta en ARCA.
  NO_APLICA
  /// La venta está registrada y falta conseguir el CAE (ARCA no respondió).
  PENDIENTE
  /// ARCA la autorizó: tiene CAE y vencimiento.
  AUTORIZADA
  /// ARCA la rechazó por un problema del comprobante. Reintentar no sirve.
  RECHAZADA
}

enum MedioPago {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  MERCADOPAGO_QR
  TRANSFERENCIA
  CUENTA_CORRIENTE
  COMBINADO
}

model Venta {
  id              String      @id @default(cuid())
  /// operacionId generado en el POS local — garantiza idempotencia en sync
  operacionId     String      @unique
  estado          EstadoVenta @default(PENDIENTE)
  subtotal        Decimal     @db.Decimal(12, 2)
  descuento       Decimal     @db.Decimal(12, 2) @default(0)
  total           Decimal     @db.Decimal(12, 2)
  medioPago       MedioPago
  cae             String?
  caeFechaVto     DateTime?
  numeroComprobante Int?
  tipoComprobante String?
  creadaEn        DateTime    @default(now())
  sincronizadaEn  DateTime?

  /// Estado de la autorización fiscal, SEPARADO del estado comercial.
  ///
  /// Una venta que espera el CAE es una venta hecha y cobrada: tiene que
  /// seguir contando en reportes, caja y stock. Si esto viviera en `estado`,
  /// una caída de ARCA borraría las ventas del día de los reportes, porque
  /// filtran por COMPLETADA.
  estadoFiscal    EstadoFiscal @default(NO_APLICA)
  /// Por qué ARCA la rechazó, para poder corregirla a mano.
  motivoFiscal    String?
  /// Cuántas veces se intentó pedir el CAE (para no reintentar para siempre).
  intentosCae     Int         @default(0)
  ultimoIntentoCae DateTime?

  sucursalId      String
  sucursal        Sucursal    @relation(fields: [sucursalId], references: [id])

  usuarioId       String
  usuario         Usuario     @relation(fields: [usuarioId], references: [id])

  /// Caja que originó la venta. Opcional: el POS lo completa desde 4.6.
  terminalId      String?
  terminal        Terminal?   @relation(fields: [terminalId], references: [id])

  /// Cliente de la venta (obligatorio en ventas a cuenta corriente). Opcional.
  clienteId       String?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])

  /// Si este comprobante es una Nota de Crédito/Débito, apunta al comprobante que anula.
  comprobanteAsociadoId String?
  comprobanteAsociado   Venta?  @relation("Anulacion", fields: [comprobanteAsociadoId], references: [id])
  notasEmitidas         Venta[] @relation("Anulacion")

  /// Descripción de la única línea de una Nota de Débito ("Intereses por mora").
  /// Una ND no vende productos —`ItemVenta` exige `productoId`— así que el
  /// concepto va acá y la impresión arma la línea con este texto y el total.
  conceptoLibre String?

  items           ItemVenta[]
  movimientosStock MovimientoStock[]
  pagos           Pago[]

  /// Correlativo por sucursal y tipo (fiscal vía CAE, no fiscal generado acá) — evita duplicados.
  @@unique([sucursalId, tipoComprobante, numeroComprobante])
  /// Para buscar los pendientes de CAE en orden, en cada reintento.
  @@index([estadoFiscal, creadaEn])
  @@map("ventas")
}

/// Desglose de pago de una venta. Una venta puede pagarse con varios medios
/// (pago combinado); cada fila es un medio con su monto. Ver ADR-0029.
model Pago {
  id        String    @id @default(cuid())
  medioPago MedioPago
  monto     Decimal   @db.Decimal(12, 2)
  creadoEn  DateTime  @default(now())

  ventaId   String
  venta     Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  /// Trazabilidad de tarjeta configurada (Fase 12.E, ADR-0050). Nullable:
  /// no todos los pagos usan una tarjeta configurada.
  cuotas          Int?
  /// Recargo de esta tarjeta ya incluido en `monto`.
  recargo         Decimal?       @db.Decimal(12, 2)
  tarjetaConfigId String?
  tarjetaConfig   TarjetaConfig? @relation(fields: [tarjetaConfigId], references: [id], onDelete: SetNull)

  @@map("pagos")
}

model ItemVenta {
  id           String   @id @default(cuid())
  cantidad     Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal @db.Decimal(12, 2)
  descuento    Decimal  @db.Decimal(12, 2) @default(0)
  subtotal     Decimal  @db.Decimal(12, 2)
  /// Costo neto del producto al momento de la venta (snapshot, ADR-0048).
  /// Nullable: las ventas sincronizadas antes de este campo no lo traen.
  costoUnitario Decimal? @db.Decimal(12, 2)

  ventaId      String
  venta        Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id])

  @@map("items_venta")
}

// ─── Caja y tesorería ─────────────────────────────────────────────────────────

enum EstadoTurnoCaja {
  ABIERTO
  CERRADO
}

model TurnoCaja {
  id            String          @id @default(cuid())
  estado        EstadoTurnoCaja @default(ABIERTO)
  fondoApertura Decimal         @db.Decimal(12, 2)   // efectivo al abrir
  abiertoEn     DateTime        @default(now())
  cerradoEn     DateTime?
  montoContado  Decimal?        @db.Decimal(12, 2)   // arqueo (conteo físico) al cerrar
  diferencia    Decimal?        @db.Decimal(12, 2)   // contado - teórico (+ sobrante / - faltante)
  /// Ventas que la terminal todavía no había subido al cerrar el turno. Si es
  /// > 0, la `diferencia` guardada se calculó contra un teórico incompleto: el
  /// efectivo de esas ventas estaba en el cajón pero no en el servidor.
  ventasSinSincronizarAlCerrar Int?
  observaciones String?

  sucursalId    String
  sucursal      Sucursal        @relation(fields: [sucursalId], references: [id])
  terminalId    String
  terminal      Terminal        @relation(fields: [terminalId], references: [id])
  usuarioId     String                                // quién abrió el turno
  usuario       Usuario         @relation(fields: [usuarioId], references: [id])

  movimientos   MovimientoCaja[]

  @@map("turnos_caja")
}

enum TipoMovimientoCaja {
  INGRESO   // aporte de efectivo a la caja
  EGRESO    // retiro / pago con efectivo de la caja
}

model MovimientoCaja {
  id           String             @id @default(cuid())
  tipo         TipoMovimientoCaja
  monto        Decimal            @db.Decimal(12, 2)
  concepto     String?
  creadoEn     DateTime           @default(now())

  turnoCajaId  String
  turnoCaja    TurnoCaja          @relation(fields: [turnoCajaId], references: [id], onDelete: Cascade)
  sucursalId   String
  sucursal     Sucursal           @relation(fields: [sucursalId], references: [id])

  @@map("movimientos_caja")
}

// ─── Clientes y cuentas corrientes ─────────────────────────────────────────────

enum CondicionIva {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

model Cliente {
  id            String       @id @default(cuid())
  nombre        String
  documento     String?      // CUIT o DNI
  condicionIva  CondicionIva @default(CONSUMIDOR_FINAL)
  email         String?
  telefono      String?
  direccion     String?
  limiteCredito Decimal      @db.Decimal(12, 2) @default(0)  // 0 = sin límite
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())

  sucursalId    String
  sucursal      Sucursal     @relation(fields: [sucursalId], references: [id])

  movimientos   MovimientoCuentaCorriente[]
  ventas        Venta[]

  @@map("clientes")
}

enum TipoMovimientoCtaCte {
  CARGO   // deuda: venta a cuenta / ajuste a favor del comercio
  PAGO    // cobro: reduce la deuda
}

model MovimientoCuentaCorriente {
  id          String               @id @default(cuid())
  tipo        TipoMovimientoCtaCte
  monto       Decimal              @db.Decimal(12, 2)
  concepto    String?
  creadoEn    DateTime             @default(now())

  clienteId   String
  cliente     Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sucursalId  String
  sucursal    Sucursal             @relation(fields: [sucursalId], references: [id])

  @@map("movimientos_cuenta_corriente")
}

// ─── Proveedores (ABM simple, sin cuenta corriente) ────────────────────────────

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  cuit      String?
  contacto  String?
  email     String?
  telefono  String?
  direccion String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  @@map("proveedores")
}

// ─── Medios de pago: tarjetas por banco con tasas por cuotas ───────────────────

enum TipoTarjeta {
  DEBITO
  CREDITO
}

model TarjetaConfig {
  id        String      @id @default(cuid())
  banco     String
  tipo      TipoTarjeta
  marca     String? // "Visa", "Mastercard", etc. (opcional)
  activo    Boolean     @default(true)
  creadoEn  DateTime    @default(now())

  sucursalId String
  sucursal   Sucursal    @relation(fields: [sucursalId], references: [id])
  tasas      TasaCuota[]
  pagos      Pago[]

  @@map("tarjetas_config")
}

model TasaCuota {
  id                String  @id @default(cuid())
  cantidadCuotas    Int
  recargoPorcentaje Decimal @db.Decimal(5, 2)

  tarjetaConfigId String
  tarjetaConfig   TarjetaConfig @relation(fields: [tarjetaConfigId], references: [id], onDelete: Cascade)

  @@unique([tarjetaConfigId, cantidadCuotas])
  @@map("tasas_cuota")
}

// ─── Presupuestos (comprobante NO fiscal) ──────────────────────────────────────

enum EstadoPresupuesto {
  VIGENTE
  CONVERTIDO
  ANULADO
}

model Presupuesto {
  id            String            @id @default(cuid())
  numero        Int
  clienteNombre String?
  observaciones String?
  validezDias   Int               @default(15)
  total         Decimal           @db.Decimal(12, 2)
  estado        EstadoPresupuesto @default(VIGENTE)
  creadoEn      DateTime          @default(now())

  sucursalId    String
  sucursal      Sucursal          @relation(fields: [sucursalId], references: [id])

  items         ItemPresupuesto[]

  @@map("presupuestos")
}

model ItemPresupuesto {
  id             String      @id @default(cuid())
  descripcion    String
  cantidad       Decimal     @db.Decimal(12, 3)
  precioUnitario Decimal     @db.Decimal(12, 2)
  subtotal       Decimal     @db.Decimal(12, 2)
  productoId     String?

  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("items_presupuesto")
}

// ─── Remitos (documento de entrega, NO fiscal, sin precios) ────────────────────

enum EstadoRemito {
  EMITIDO
  ANULADO
}

model Remito {
  id            String       @id @default(cuid())
  numero        Int
  clienteNombre String?
  observaciones String?
  estado        EstadoRemito @default(EMITIDO)
  creadoEn      DateTime     @default(now())

  sucursalId    String
  sucursal      Sucursal     @relation(fields: [sucursalId], references: [id])

  items         ItemRemito[]
  movimientos   MovimientoStock[]

  @@map("remitos")
}

model ItemRemito {
  id          String  @id @default(cuid())
  descripcion String
  cantidad    Decimal @db.Decimal(12, 3)
  productoId  String?

  remitoId    String
  remito      Remito  @relation(fields: [remitoId], references: [id], onDelete: Cascade)

  @@map("items_remito")
}
